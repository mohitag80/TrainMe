y relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-27" value="S6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-8" target="srch-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-28" value="S8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-8" target="srch-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="855"/></Array></mxGeometry></mxCell><mxCell id="srch-29" value="streaming replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-12" target="srch-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-30" value="archive &gt; 13 mo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-12" target="srch-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-31" value="&lt;b&gt;Latency budget (outer → inner)&lt;/b&gt;&lt;br&gt;client 6 s / 3 s → Kong &lt;b&gt;5 s / 2 s&lt;/b&gt; → service 4.5 s / 1.8 s → Postgres statement_timeout 4 s / 1.5 s → 504 search-timeout&lt;br&gt;&lt;b&gt;Design targets (p95)&lt;/b&gt;: catalog ≤ 150 ms · sessions ≤ 300 ms · by metric ≤ 300 ms · entries ≤ 800 ms&lt;br&gt;&lt;b&gt;Guards&lt;/b&gt;: date range required (default 90 d, entries ≤ 12 months) · LIMIT ≤ 50 + keyset cursor · filters only from the effective schema · CI query-plan tests (no seq scans)&lt;br&gt;&lt;b&gt;Proof&lt;/b&gt;: k3s seeded with 10K users × 30 days (~45 M entries) → k6 mixed search + live writes, p99 &amp;lt; 2 s incl. cold cache" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
