w=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dom-82"><mxGeometry x="0" y="30" width="500" height="22" as="geometry"/></mxCell><mxCell id="dom-84" value="&amp;nbsp;&amp;nbsp;no_ball · &lt;b&gt;slower_ball&lt;/b&gt; (wide hidden)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dom-82"><mxGeometry x="0" y="52" width="500" height="22" as="geometry"/></mxCell><mxCell id="dom-85" value="Metrics: yorker / seam / bouncer accuracy · no_ball_rate · &lt;b&gt;slower_ball_rate&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dom-82"><mxGeometry x="0" y="74" width="500" height="22" as="geometry"/></mxCell><mxCell id="dom-86" value="→ JSON Schema 2020-12 with if/then rules · cached in Redis · ETag v3" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dom-82"><mxGeometry x="0" y="96" width="500" height="22" as="geometry"/></mxCell><mxCell id="dom-87" value="&lt;b&gt;Live session · 2026-10-03 06:10 → 06:50 · 50 balls · COMPLETED&lt;/b&gt;&lt;br&gt;&lt;table style='font-size:10px;border-collapse:collapse' border='1' cellpadding='2'&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;over&lt;/th&gt;&lt;th&gt;speed&lt;/th&gt;&lt;th&gt;yorker A/✓&lt;/th&gt;&lt;th&gt;seam A/✓&lt;/th&gt;&lt;th&gt;bouncer A/✓&lt;/th&gt;&lt;th&gt;nb&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;131.4&lt;/td&gt;&lt;td&gt;✔ / ✔&lt;/td&gt;&lt;td&gt;✔ / ✔&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;134.0&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;✔ / ✘&lt;/td&gt;&lt;td&gt;✔ / ✔&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;129.8&lt;/td&gt;&lt;td&gt;✔ / ✘&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;td&gt;…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;132.6&lt;/td&gt;&lt;td&gt;✔ / ✔&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;– / –&lt;/td&gt;&lt;td&gt;✘&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;i&gt;logged ball-by-ball on device · synced in ~10 checkpoints (every 3–5 min) · submitted on End&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="420" width="500" height="190" as="geometry"/></mxCell><mxCell id="dom-88" value="&lt;b&gt;Analytics (DAY / WEEK / MONTH)&lt;/b&gt;&lt;br&gt;• seam accuracy = 23 ÷ 30 = &lt;b&gt;76.7 %&lt;/b&gt;&lt;br&gt;• yorker accuracy = 12 ÷ 18 = &lt;b&gt;66.7 %&lt;/b&gt;&lt;br&gt;• bouncer accuracy = 5 ÷ 8 = &lt;b&gt;62.5 %&lt;/b&gt;&lt;br&gt;• no-ball rate = 3 ÷ 50 = &lt;b&gt;6 %&lt;/b&gt; · avg speed 131.8 km/h&lt;br&gt;• week / month = Σnum ÷ Σden over sessions (never an average of percentages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="700" width="500" height="130" as="geometry"/></mxCell><mxCell id="dom-89" value="base" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="dom-46" target="dom-82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dom-90" value="applied on top" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="dom-77" target="dom-82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dom-91" value="drives live form, conditional rules, validation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="dom-82" target="dom-87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dom-92" value="record.session.completed → rollups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="dom-87" target="dom-88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dom-93" value="&lt;b&gt;Same model for every profile&lt;/b&gt;&lt;br&gt;• Every activity can be recorded at entry level: ball, set, lap, shot, food item&lt;br&gt;• Parameters are typed (INT, DECIMAL, BOOL, ENUM, TEXT, DURATION) with optional &lt;i&gt;condition&lt;/i&gt; (shown/required when another value matches)&lt;br&gt;• Metrics are data: RATIO or SINGLE built from COUNT / COUNT_TRUE / SUM with optional filters → any ratio chart without code&lt;br&gt;• New sport / exercise / metric = catalog rows; templates versioned; sessions pin schema_version so history never breaks" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="940" width="740" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
