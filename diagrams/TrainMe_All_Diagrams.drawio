=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800.0" y="828" as="sourcePoint"/><mxPoint x="1240.0" y="828" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-29" value="15. 200 {acceptedThrough: k, rejected[] with field errors}" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="862" as="sourcePoint"/><mxPoint x="350.0" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-30" value="16. Mark entries synced; keep rejected for user fix" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;strokeColor=#333333;labelBackgroundColor=default;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="892" as="sourcePoint"/><mxPoint x="350.0" y="918" as="targetPoint"/><Array as="points"><mxPoint x="380.0" y="892"/><mxPoint x="380.0" y="918"/></Array></mxGeometry></mxCell><mxCell id="sqr-31" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=60;height=24;fontStyle=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#888888;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="594" width="1180" height="352" as="geometry"/></mxCell><mxCell id="sqr-32" value="[every 3–5 min (remote-config, ±30 s jitter) · also on app background / tab hidden, network regain, ≥ 25 unsynced entries]" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="218" y="596" width="1100" height="20" as="geometry"/></mxCell><mxCell id="sqr-33" value="17. End session" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoin