aphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-1" value="TrainMe – Microservices Architecture (C4 Level 2)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="34" as="geometry"/></mxCell><mxCell id="arch-2" value="Each bounded context = independently deployable &amp; scalable service + its own database (database-per-service). Async integration through the event bus." style="text;html=1;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1920" height="24" as="geometry"/></mxCell><mxCell id="arch-3" value="&lt;b&gt;Mobile App&lt;/b&gt;&lt;br&gt;React Native (Expo) · iOS &amp;amp; Android&lt;br&gt;offline-first (SQLite + sync queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="240" height="76" as="geometry"/></mxCell><mxCell id="arch-4" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;Next.js · responsive PWA&lt;br&gt;laptop / tablet / mobile browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="240" height="76" as="geometry"/></mxCell><mxCell id="arch-5" value="&lt;b&gt;Admin Console&lt;/b&gt;&lt;br&gt;React (Next.js) · RBAC&lt;br&gt;catalog &amp;amp; template curation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="240" height="76" as="geometry"/></mxCell><mxCell id="arch-6" value="&lt;b&gt;Social IdPs&lt;/b&gt;&lt;br&gt;Google / Apple" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="100" width="170" height="60" as="geometry"/></mxCell><mxCell id="arch-7" value="Edge &amp;amp; Access Layer" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="1460" height="130" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;DNS · CDN · WAF&lt;/b&gt;&lt;br&gt;AWS: Route 53 + CloudFront + WAF&lt;br&gt;k3s: DNS → node IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="arch-7"><mxGeometry x="30" y="35" width="240" height="80" as="geometry"/></mxCell><mxCell id="arch-9" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;AWS: ALB (multi-AZ)&lt;br&gt;k3s: ServiceLB (klipper)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="arch-7"><mxGeometry x="300" y="35" width="220" height="80" as="geometry"/></mxCell><mxCell id="arch-10" value="&lt;b&gt;API Gateway – Kong (Ingress Controller)&lt;/b&gt;&lt;br&gt;JWT validation · rate limiting · CORS · routing&lt;br&gt;request-id / W3C traceparent · request size limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="arch-7"><mxGeometry x="550" y="35" width="330" height="80" as="geometry"/></mxCell><mxCell id="arch-11" value="&lt;b&gt;Identity Provider – Keycloak&lt;/b&gt;&lt;br&gt;OIDC / OAuth 2.1 · PKCE · MFA&lt;br&gt;social login · roles &amp;amp; plan claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="arch-7"><mxGeometry x="930" y="35" width="270" height="80" as="geometry"/></mxCell