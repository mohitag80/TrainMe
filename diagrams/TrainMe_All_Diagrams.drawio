used by Fast Bowler, Spin Bowler, Batter, Wicket-keeper, Fielder and All-rounder; &lt;i&gt;Barbell Bench Press&lt;/i&gt; by Chest Workout, Push Day, Strength 5×5 and Upper Body." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="1242" width="640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="srch" name="14 Search Query Paths"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="srch-1" value="Search &amp; Query Paths – 10K users, &lt; 5 s production / &lt; 2 s test" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="34" as="geometry"/></mxCell><mxCell id="srch-2" value="Every history query is user-scoped (user_id leads every index) → cost grows with ONE user's data (~55 k entries/yr), not the whole database (~550 M entries/yr)" style="text;html=1;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1920" height="24" as="geometry"/></mxCell><mxCell id="srch-3" value="&lt;b&gt;Search UIs&lt;/b&gt;&lt;br&gt;catalog search &amp;amp; autocomplete · my sessions · my best sessions · my entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="220" height="110" as="geometry"/></mxCell><mxCell id="srch-4" value="&lt;b&gt;CDN / Kong proxy-cache&lt;/b&gt;&lt;br&gt;public catalog GETs&lt;br&gt;max-age 300 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="220" height="80" as="geometry"/></mxCell><mxCell id="srch-5" value="&lt;b&gt;Kong API Gateway&lt;/b&gt;&lt;br&gt;route timeout &lt;b&gt;5 s prod / 2 s test&lt;/b&gt;&lt;br&gt;rate limits per user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="220" height="110" as="geometry"/></mxCell><mxCell id="srch-6" value="&lt;b&gt;catalog-svc&lt;/b&gt;&lt;br&gt;GET /catalog/search · /suggest · /facets&lt;br&gt;deadline 4.5 s / 1.8 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="270" height="90" as="geometry"/></mxCell><mxCell id="srch-7" value="&lt;b&gt;records-svc&lt;/b&gt;&lt;br&gt;GET /sessions?tracker&amp;amp;from&amp;amp;to&lt;br&gt;GET /sessions/search?q= (notes, tags)&lt;br&gt;GET /entries/search?activity&amp;amp;where" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="420" width="270" height="110" as="geometry"/></mxCell><mxCell id="srch-8" value="&lt;b&gt;analytics-svc&lt;/b&gt;&lt;br&gt;GET /analytics/sessions/search?metric&amp;amp;min&amp;amp;sort&lt;br&gt;GET /analytics/records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="270" height="90" as="geometry"/></mxCell><mxCell id="srch-9" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;cs:{catalogVersion}:{hash} 10 min&lt;br&gt;sug:{prefix} 30 min · facets 1 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="260" height="80" as="geometry"/></mxCell><mxCell id="srch-10" value="&lt;b&gt;catalog_search_doc&lt;/b&gt;&lt;br&gt;GIN tsvector (A name · B synonyms · C facets · D text)&lt;br&gt;GIN pg_trgm (typos) · GIN facet arrays&lt;br&gt;~150 → few thousand rows · 5–30 ms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="300" height="130" as="geometry"/></mxCell><mxCell id="srch-11" value="&lt;b&gt;activity_session&lt;/b&gt; (monthly partitions)&lt;br&gt;idx (user_id, tracker_id, session_date DESC)&lt;br&gt;GIN (user_id, search_tsv) via btree_gin&lt;br&gt;~11 M rows/yr · &amp;lt; 20 ms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="340" width="300" height="130" as="geometry"/></mxCell><mxCell id="srch-12" value="&lt;b&gt;activity_entry&lt;/b&gt; (monthly partitions, JSONB values)&lt;br&gt;idx (user_id, activity_code, session_date DESC)&lt;br&gt;≤ 12-month range · typed JSONB filter&lt;br&gt;~548 M rows/yr · 30–800 ms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="300" height="140" as="geometry"/></mxCell><mxCell id="srch-13" value="&lt;b&gt;session_metric&lt;/b&gt;&lt;br&gt;idx (user_id, tracker_id, metric_key, value DESC)&lt;br&gt;~110 M rows/yr · &amp;lt; 20 ms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="670" width="300" height="110" as="geometry"/></mxCell><mxCell id="srch-14" value="&lt;b&gt;personal_record&lt;/b&gt; · &lt;b&gt;metric_rollup&lt;/b&gt;&lt;br&gt;PK lookups · &amp;lt; 10 ms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="810" width="300" height="90" as="geometry"/></mxCell><mxCell id="srch-15" value="&lt;b&gt;Read replica&lt;/b&gt; (optional)&lt;br&gt;route /search here when &amp;gt; 20 req/s or p95 &amp;gt; 500 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="240" height="90" as="geometry"/></mxCell><mxCell id="srch-16" value="&lt;b&gt;Deep search (async)&lt;/b&gt;&lt;br&gt;POST /exports/entry-search (records-svc)&lt;br&gt;entries older than 12 months&lt;br&gt;S3 Parquet → Athena (AWS) / DuckDB (k3s)&lt;br&gt;user notified when ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="600" width="240" height="110" as="geometry"/></mxCell><mxCell id="srch-17" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-3" target="srch-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-18" value="anonymous catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-3" target="srch-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="190"/></Array></mxGeometry></mxCell><mxCell id="srch-19" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-4" target="srch-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.2;entryX=0;entryY=0.7;" edge="1" parent="1" source="srch-5" target="srch-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-5" target="srch-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-5" target="srch-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-23" value="cache-aside" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=0.7;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-6" target="srch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-24" value="FTS + trigram + facets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-6" target="srch-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-25" value="S4 / S5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-7" target="srch-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-26" value="S7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-7" target="srch-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-27" value="S6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="srch-8" target="srch-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-28" value="S8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-8" target="srch-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="855"/></Array></mxGeometry></mxCell><mxCell id="srch-29" value="streaming replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-12" target="srch-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-30" value="archive &gt; 13 mo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="srch-12" target="srch-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="srch-31" value="&lt;b&gt;Latency budget (outer → inner)&lt;/b&gt;&lt;br&gt;client 6 s / 3 s → Kong &lt;b&gt;5 s / 2 s&lt;/b&gt; → service 4.5 s / 1.8 s → Postgres statement_timeout 4 s / 1.5 s → 504 search-timeout&lt;br&gt;&lt;b&gt;Design targets (p95)&lt;/b&gt;: catalog ≤ 150 ms · sessions ≤ 300 ms · by metric ≤ 300 ms · entries ≤ 800 ms&lt;br&gt;&lt;b&gt;Guards&lt;/b&gt;: date range required (default 90 d, entries ≤ 12 months) · LIMIT ≤ 50 + keyset cursor · filters only from the effective schema · CI query-plan tests (no seq scans)&lt;br&gt;&lt;b&gt;Proof&lt;/b&gt;: k3s seeded with 10K users × 30 days (~45 M entries) → k6 mixed search + live writes, p99 &amp;lt; 2 s incl. cold cache" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
