obs-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="obs-31" value="&lt;b&gt;Log standard (JSON, one line per event)&lt;/b&gt;&lt;br&gt;timestamp · level · service · version · env · trace_id · span_id · request_id · user_id (pseudonymised) · route · status · latency_ms · message · error.stack&lt;br&gt;&lt;b&gt;Levels&lt;/b&gt;: ERROR · WARN · INFO (default) · DEBUG / TRACE switchable per service at runtime (config flag / admin endpoint, auto-revert after 30 min)&lt;br&gt;&lt;b&gt;Propagation&lt;/b&gt;: W3C traceparent + baggage over HTTP and as Kafka record headers · never log secrets, tokens or raw health data" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1560" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tax" name="13 Phase 1 Catalog Taxonomy"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1710" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tax-1" value="Phase 1 Catalog – Sports → Roles and Gym → Muscle Groups (generated from catalog/phase1/catalog.json)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2060" height="34" as="geometry"/></mxCell><mxCell id="tax-2" value="45 categories · 40 profile templates · 147 reusable library activities · roles exist only where the sport has them (no roles in Lawn Tennis / Badminton)" style="text;html=1;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="2060" height="24" as="geometry"/></mxCell><mxCell id="tax-3" value="&lt;b&gt;Sports&lt;/b&gt; &lt;font color='#777777' styl