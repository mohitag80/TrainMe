" parent="1"><mxGeometry x="940" y="100" width="160" height="1420" as="geometry"/></mxCell><mxCell id="sqr-8" value="records_db" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="100" width="160" height="1420" as="geometry"/></mxCell><mxCell id="sqr-9" value="Event Bus" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="100" width="160" height="1420" as="geometry"/></mxCell><mxCell id="sqr-10" value="analytics-svc" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1615" y="100" width="160" height="1420" as="geometry"/></mxCell><mxCell id="sqr-11" value='1. Start session · tracker "My Fast Bowling"' style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="190" as="sourcePoint"/><mxPoint x="340.0" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-12" value="2. Create local session (client_session_id) · pin schema v3 (cached)" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;strokeColor=#333333;labelBackgroundColor=default;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="226" as="sourcePoint"/><mxPoint x="350.0" y="252" as="targetPoint"/><Array as="points"><mxPoint x="380.0" y="226"/><mxPoint x="380.0" y="252"/></Array></mxGeometry></mxCell><mxCell id="sqr-13" value="3. POST /api/v1/sessions {clientSessionId, trackerId, schemaVersion: 3, startedAt}" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="276" as="sourcePoint"/><mxPoint x="565.0" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-14" value="4. forward (user from JWT)" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575.0" y="310" as="sourcePoint"/><mxPoint x="790.0" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-15" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="790.0" y="314" width="10" height="100" as="geometry"/></mxCell><mxCell id="sqr-16" value="5. INSERT session status=IN_PROGRESS (idempotent on client_session_id)" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800.0" y="344" as="sourcePoint"/><mxPoint x="1240.0" y="344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-17" value="6. 201 {sessionId, status: IN_PROGRESS}" style="html=1;verticalAlign=bottom;labelBackgroundColor=default;fontSize=10;rounded=0;strokeColor=#333333;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="378" as="sourcePoint"/><mxPoint x="350.0" y="378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sqr-18" value="7. Log ball n (speed, attem