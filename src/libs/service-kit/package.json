{
  "name": "@trainme/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Fastify bootstrap shared by every service: errors, auth, health, metrics, logging",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@trainme/auth": "workspace:*",
    "@trainme/cache": "workspace:*",
    "@trainme/db": "workspace:*",
    "@trainme/errors": "workspace:*",
    "@trainme/kafka": "workspace:*",
    "@trainme/observability": "workspace:*",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
