  },
  "dependencies": {
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "uuid": "^14.0.2",
    "@trainme/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
