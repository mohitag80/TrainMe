{
  "name": "@trainme/db",
  "version": "0.1.0",
  "private": true,
  "description": "Kysely/pg database access, UUIDv7 ids and the SQL migrator",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
