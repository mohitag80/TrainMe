{
  "name": "@trainme/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Tracker schema: template/override types, effective-schema compiler, entry validation (Ajv 2020-12) and metric evaluation shared by server and clients",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "@trainme/units": "workspace:*"
  }
}
