{
  "name": "@trainme/kafka",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional outbox, outbox relay and idempotent CloudEvents consumer over KafkaJS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "kysely": "^0.29.6",
    "@trainme/db": "workspace:*",
    "@trainme/events": "workspace:*",
    "@trainme/observability": "workspace:*"
  }
}
