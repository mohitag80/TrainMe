{
  "name": "@trainme/web",
  "version": "0.1.0",
  "private": true,
  "description": "TrainMe web app (Next.js App Router) with a backend-for-frontend for OIDC login and API calls",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
