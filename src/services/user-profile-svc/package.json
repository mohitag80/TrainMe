{
  "name": "@trainme/user-profile-svc",
  "version": "0.1.0",
  "private": true,
  "description": "User profile: preferences, units, devices, export and erasure orchestration",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@trainme/auth": "workspace:*",
    "@trainme/cache": "workspace:*",
    "@trainme/config": "workspace:*",
    "@trainme/db": "workspace:*",
    "@trainme/errors": "workspace:*",
    "@trainme/events": "workspace:*",
    "@trainme/kafka": "workspace:*",
    "@trainme/observability": "workspace:*",
    "@trainme/service-kit": "workspace:*",
    "kysely": "^0.29.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
