# Copy to .env and adjust. Never commit .env.
COMPOSE_PROJECT_NAME=trainme

# Public origin users open in the browser (Kong proxy).
#   Laptop: http://localhost:8000      Remote VM: https://<vm-hostname>:8443 (HTTPS is required off localhost)
TRAINME_PUBLIC_URL=http://localhost:8000
TRAINME_HTTP_PORT=8000
TRAINME_HTTPS_PORT=8443

# Database superuser and per-service roles (test values only).
POSTGRES_PASSWORD=postgres-dev
CATALOG_DB_PASSWORD=catalog-dev
TRACKER_DB_PASSWORD=tracker-dev
RECORDS_DB_PASSWORD=records-dev
ANALYTICS_DB_PASSWORD=analytics-dev
PROFILE_DB_PASSWORD=profile-dev
BILLING_DB_PASSWORD=billing-dev
NOTIFICATION_DB_PASSWORD=notification-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_SERVICES_CLIENT_SECRET=services-dev-secret
TEST_USER_PASSWORD=Passw0rd!

# Mock payment provider: shared secret for signed webhooks.
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-dev-secret

LOG_LEVEL=info

# Host port for direct DB access (psql, local service runs). 5432 is often taken by a local PostgreSQL.
POSTGRES_HOST_PORT=55432
