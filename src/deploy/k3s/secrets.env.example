# Copy to secrets.env (git-ignored) and change every value. install.sh turns it into Kubernetes Secrets.
# Production-like environments use Sealed Secrets (k3s) or AWS Secrets Manager + External Secrets (EKS).
CATALOG_DB_PASSWORD=change-me-catalog
TRACKER_DB_PASSWORD=change-me-tracker
RECORDS_DB_PASSWORD=change-me-records
ANALYTICS_DB_PASSWORD=change-me-analytics
PROFILE_DB_PASSWORD=change-me-profile
BILLING_DB_PASSWORD=change-me-billing
NOTIFICATION_DB_PASSWORD=change-me-notification
KEYCLOAK_DB_PASSWORD=change-me-keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_SERVICES_CLIENT_SECRET=change-me-services-secret
TEST_USER_PASSWORD=Passw0rd!
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
